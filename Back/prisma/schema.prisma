// ================================
// PRISMA SCHEMA - E-COMMERCE + PUNTO DE VENTA PROFESIONAL
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELOS EXISTENTES (SIN CAMBIOS)
// ============================================

model User {
  id          Int      @id @default(autoincrement())
  img         String?
  nombre      String
  email       String   @unique
  telefono    String   @unique
  password    String
  rol         String   @default("gerente")
  empresaId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imgPublicId String?
  empresa     Empresa? @relation("EmpresaUsuarios", fields: [empresaId], references: [id])
}

model Empresa {
  id          Int      @id @default(autoincrement())
  nombre      String
  nit         String   @unique
  direccion   String
  ciudad      String
  telefono    String
  email       String   @unique
  moneda      String
  zonaHoraria String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  articulos           Articulo[]
  bodegas             Bodega[]
  proveedores         Proveedor[]
  usuarios            User[]              @relation("EmpresaUsuarios")
  categoriasArticulos CategoriaArticulo[]
  marcas              Marca[]
}

model Bodega {
  id         Int          @id @default(autoincrement())
  nombre     String
  direccion  String
  empresaId  Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  empresa    Empresa      @relation(fields: [empresaId], references: [id])
  compras    Compra[]
  inventario SkuInventario[] // ✅ CAMBIADO: Ahora maneja SKUs
}

model CategoriaArticulo {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  icono       String?
  empresaId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  articulos Articulo[] @relation("ArticuloCategoria")

  @@unique([nombre, empresaId])
  @@map("categorias_articulos")
}

model Marca {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  logo        String?
  empresaId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  articulos Articulo[] @relation("ArticuloMarca")

  @@unique([nombre, empresaId])
  @@map("marcas")
}

// ============================================
// MODELOS RENOVADOS PARA E-COMMERCE
// ============================================

model Articulo {
  id            Int      @id @default(autoincrement())
  nombre        String
  codigo        String   @unique  // Código interno del producto base
  descripcion   String?
  precio        Float    // Precio base (se usa como referencia)
  empresaId     Int
  categoriaId   Int?
  marcaId       Int?
  fotoPrincipal String?
  activo        Boolean  @default(true) // ✅ NUEVO: Control de activación
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones actualizadas
  empresa         Empresa            @relation(fields: [empresaId], references: [id])
  categoria       CategoriaArticulo? @relation("ArticuloCategoria", fields: [categoriaId], references: [id])
  marca           Marca?             @relation("ArticuloMarca", fields: [marcaId], references: [id])
  
  // ✅ NUEVAS RELACIONES E-COMMERCE
  skus            ArticuloSku[]      // SKUs generados automáticamente
  articuloValores ArticuloVariante[] // Mantener para compatibilidad
  fotos           Foto[]
  precios         PrecioArticulo[]   @relation("ArticuloToPrecioArticulo")
  
  // ❌ ELIMINADA: variantes Variante[] - Reemplazada por SKUs
}

// ============================================
// NUEVO: SISTEMA DE SKUs PROFESIONAL
// ============================================

model ArticuloSku {
  id          Int      @id @default(autoincrement())
  sku         String   @unique  // "CAM-POLO-ROJ-XL-001"
  codigoBarras String? @unique  // Código de barras para POS
  articuloId  Int
  precioBase  Float?   // Precio específico del SKU (opcional)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  articulo     Articulo         @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  combinacion  SkuVariante[]    // Combinación de variantes del SKU
  inventario   SkuInventario[]  // Inventario por bodega
  detallesCompra CompraDetalle[] // ✅ NUEVO: Compras por SKU
  
  @@index([articuloId])
  @@index([sku])
  @@index([codigoBarras])
}

model SkuVariante {
  id             Int @id @default(autoincrement())
  skuId          Int
  valorVarianteId Int

  sku           ArticuloSku   @relation(fields: [skuId], references: [id], onDelete: Cascade)
  valorVariante ValorVariante @relation(fields: [valorVarianteId], references: [id])

  @@unique([skuId, valorVarianteId])
  @@index([skuId])
}

model SkuInventario {
  id         Int      @id @default(autoincrement())
  skuId      Int
  bodegaId   Int
  ubicacion  String   @default("GENERAL")
  cantidad   Int      @default(0)
  minimo     Int      @default(0)
  maximo     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sku    ArticuloSku @relation(fields: [skuId], references: [id])
  bodega Bodega      @relation(fields: [bodegaId], references: [id])

  @@unique([skuId, bodegaId, ubicacion])
  @@map("SkuInventario")
}


// ============================================
// MODELOS DE VARIANTES (MANTENIDOS)
// ============================================

model TipoVariante {
  id      Int             @id @default(autoincrement())
  nombre  String          @unique
  orden   Int?            // ✅ NUEVO: Orden de aparición en frontend
  activo  Boolean         @default(true)
  valores ValorVariante[]
}

model ValorVariante {
  id              Int                @id @default(autoincrement())
  nombre          String
  codigo          String?            // ✅ NUEVO: Código corto (ej: "ROJ", "XL")
  hexColor        String?            // ✅ NUEVO: Para colores en hex
  imagen          String?            // ✅ NUEVO: Imagen de la variante
  tipoVarianteId  Int
  orden           Int?               // ✅ NUEVO: Orden de aparición
  activo          Boolean            @default(true)

  tipoVariante    TipoVariante       @relation(fields: [tipoVarianteId], references: [id])
  articuloValores ArticuloVariante[]
  skuVariantes    SkuVariante[]      // ✅ NUEVA: Relación con SKUs

  @@index([tipoVarianteId])
}

model ArticuloVariante {
  id         Int           @id @default(autoincrement())
  articuloId Int
  valorId    Int
  articulo   Articulo      @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  valor      ValorVariante @relation(fields: [valorId], references: [id])

  @@unique([articuloId, valorId])
}

// ============================================
// SISTEMA DE PRECIOS (MANTENIDO Y MEJORADO)
// ============================================

model TipoPrecio {
  id          Int              @id @default(autoincrement())
  nombre      String           @unique
  descripcion String?          // ✅ NUEVO: Descripción del tipo
  activo      Boolean          @default(true)
  creado      DateTime         @default(now())
  precios     PrecioArticulo[]
}

model PrecioArticulo {
  id           Int        @id @default(autoincrement())
  articuloId   Int
  valor        Float
  margen       Float?     // ✅ NUEVO: Margen de ganancia
  creadoEn     DateTime   @default(now())
  actualizado  DateTime   @updatedAt
  tipoPrecioId Int
  activo       Boolean    @default(true)

  articulo   Articulo   @relation("ArticuloToPrecioArticulo", fields: [articuloId], references: [id], onDelete: Cascade)
  tipoPrecio TipoPrecio @relation(fields: [tipoPrecioId], references: [id])

  @@unique([articuloId, tipoPrecioId])
  @@index([articuloId])
}

// ============================================
// SISTEMA DE COMPRAS ACTUALIZADO
// ============================================

model Compra {
  id             Int              @id @default(autoincrement())
  numero         String           @unique // ✅ NUEVO: Número de compra
  proveedorId    Int
  tipoPago       TipoPago
  fecha          DateTime         @default(now())
  bodegaId       Int
  estado         EstadoCompra     @default(PENDIENTE) // ✅ NUEVO
  total          Float            @default(0) // ✅ NUEVO
  observaciones  String?          // ✅ NUEVO
  createdAt      DateTime         @default(now())

  bodega         Bodega           @relation(fields: [bodegaId], references: [id])
  proveedor      Proveedor        @relation(fields: [proveedorId], references: [id])
  detalles       CompraDetalle[]
  cuentasPorPagar CuentaPorPagar[]
}

model CompraDetalle {
  id          Int      @id @default(autoincrement())
  compraId    Int
  skuId       Int      // ✅ CAMBIADO: Ahora usa SKU en lugar de variante
  cantidad    Int
  valorCompra Float
  valorVenta  Float
  descuento   Float    @default(0) // ✅ NUEVO

  compra Compra      @relation(fields: [compraId], references: [id], onDelete: Cascade)
  sku    ArticuloSku @relation(fields: [skuId], references: [id]) // ✅ NUEVO

  @@index([compraId])
  @@index([skuId])
}

// ============================================
// OTROS MODELOS (SIN CAMBIOS IMPORTANTES)
// ============================================

model Foto {
  id         Int      @id @default(autoincrement())
  url        String
  publicId   String   @unique
  orden      Int?
  articuloId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  articulo   Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
}

model Proveedor {
  id        Int      @id @default(autoincrement())
  nombre    String
  nit       String   @unique
  direccion String?
  telefono  String?
  email     String?
  empresaId Int
  activo    Boolean  @default(true) // ✅ NUEVO
  compras   Compra[]
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
}

model CuentaPorPagar {
  id             Int                  @id @default(autoincrement())
  compraId       Int
  saldoTotal     Float
  saldoPendiente Float
  estado         EstadoCuentaPorPagar @default(PENDIENTE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  abonos         AbonoCuenta[]
  compra         Compra               @relation(fields: [compraId], references: [id])
}

model AbonoCuenta {
  id               Int            @id @default(autoincrement())
  cuentaPorPagarId Int
  monto            Float
  fecha            DateTime       @default(now())
  cuentaPorPagar   CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id])
}

// ============================================
// ENUMS
// ============================================

enum TipoPago {
  contado
  credito
}

enum EstadoCuentaPorPagar {
  PENDIENTE
  PAGADA
  VENCIDA
}

enum EstadoCompra {
  PENDIENTE
  RECIBIDA
  CANCELADA
}